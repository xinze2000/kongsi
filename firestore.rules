rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: any authenticated user can read profiles (needed for friends lookup & displaying names)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Any authenticated user can read group info or join via invite link
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow updating members list (joining or inviting)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;

      // Group subcollections: only accessible to group members
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
      
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null;
      }

      match /activity/{activityId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
